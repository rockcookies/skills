{
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "tsx scripts/sync.ts",
    "upstream": "tsx scripts/upstream.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "packs": "tsx scripts/packs.ts",
    "check": "tsx scripts/check.ts",
    "build:catalog": "tsx scripts/catalog.ts",
    "smoke": "tsx scripts/smoke.ts",
    "site:build": "pnpm build:catalog && tsx scripts/prepare-site.ts && pnpm --filter ./site build",
    "site:preview": "pnpm site:build && pnpm --filter ./site preview"
  },
  "dependencies": {
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "simple-git": "^3.36.0",
    "skills": "1.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.2"
}
