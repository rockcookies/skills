{
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "tsx src/commands/sync.command.ts",
    "upstream": "tsx src/commands/upstream.command.ts",
    "cleanup": "tsx src/commands/cleanup.command.ts",
    "packs": "tsx src/commands/pack.command.ts",
    "check": "tsx src/commands/check.command.ts",
    "build:catalog": "tsx src/commands/catalog.command.ts",
    "smoke": "tsx src/commands/smoke.command.ts",
    "site:build": "pnpm build:catalog && tsx src/commands/prepare-site.command.ts && pnpm --filter ./site build",
    "site:preview": "pnpm site:build && pnpm --filter ./site preview"
  },
  "dependencies": {
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "simple-git": "^3.36.0",
    "skills": "1.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.2"
}
